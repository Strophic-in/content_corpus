# Content Corpus — copy to .env (repo root) and fill in. Never commit .env.
# The web app (apps/web/lib/env.ts) and the workers both read this one file.

# ── Database (Postgres 16+; we use VibeDB) ─────────────────────────────────────
# Owner role, pooled: workers. Owner role, direct (not the pooler): db/migrate.py.
DATABASE_URL=postgresql://OWNER:PASSWORD@HOST:6432/content_corpus?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://OWNER:PASSWORD@HOST:5432/content_corpus?sslmode=verify-full
# The restricted web role (row-level security applies): the web app only.
WEB_DATABASE_URL=postgresql://corpus_web:PASSWORD@HOST:6432/content_corpus?sslmode=verify-full
# Optional: name of the web role if not corpus_web (db/migrate.py, db/access.sql).
# CORPUS_WEB_ROLE=corpus_web

# ── Web app / auth (Better Auth) ───────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=                 # openssl rand -base64 32
# Who may sign up (comma-separated). Everyone else is refused.
AUTH_ALLOWED_EMAILS=you@example.com
# Shown on the public homepage, privacy policy and terms (defaults to the first
# address above). Google's and Meta's app reviews require a contact.
PRIVACY_CONTACT_EMAIL=
# Optional "Sign in with Google" (also used later for YouTube uploads).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts users' API keys (e.g. OpenAI) at rest; shared by web and workers.
APP_ENCRYPTION_KEY=                 # openssl rand -base64 32

# ── Storage: Cloudflare R2 (private bucket; the app enforces a 9 GB cap) ──────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=content-corpus-media

# ── GPU rendering: Race Engineering + Hugging Face (LTX-2.5 is gated) ─────────
RACE_API_KEY=                       # rk_… with scopes: read, deploy
HF_TOKEN=                           # hf_… with access to Lightricks/LTX-2.5
# CORPUS_RACE_SLICES=5,16,11        # slices to deploy on when no paused pod is free
# CORPUS_RENDER_PODS=2              # GPUs per render (main + cached helpers)

# ── Workers ────────────────────────────────────────────────────────────────────
# One process per lane: CORPUS_LANE=cpu and CORPUS_LANE=gpu (set per process).
# The web app and the workers wake each other after queueing work:
CORPUS_WAKE_URL=http://127.0.0.1:8787/wake,http://127.0.0.1:8788/wake,http://127.0.0.1:8789/wake,http://127.0.0.1:8790/wake
CORPUS_WAKE_TOKEN=                  # openssl rand -hex 32
# CORPUS_WAKE_PORT=8787             # per process: 8787 cpu, 8788 gpu, 8789 publish, 8790 ideas
# CORPUS_IDLE_MAX_SECONDS=300       # longest idle sleep between queue checks
# CORPUS_CACHE_DIR=~/.cache/content_corpus    # shot segments waiting for assembly
# CORPUS_MODELS_DIR=~/.cache/content_corpus   # Kokoro TTS model files

# ── Idea agent memory (optional): a Qdrant the cpu worker can reach ────────────
# Without it, ideas are still made; only the never-repeat check across batches is off.
QDRANT_URL=
QDRANT_API_KEY=

# ── Connecting accounts (Channels → Connect) ───────────────────────────────────
# YouTube uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above (redirect URI:
#   <BETTER_AUTH_URL>/api/connect/youtube/callback). Instagram API with Instagram Login:
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=                # redirect URI: <BETTER_AUTH_URL>/api/connect/instagram/callback
